# Скопируй в .env и заполни.
DATABASE_URL=postgresql+asyncpg://levelup:levelup@localhost:5433/levelup

# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Client ID iOS-клиента из Google Cloud Console (через запятую, если их несколько).
GOOGLE_CLIENT_IDS=

# Шифрует ключи ИИ пользователей. Сгенерировать:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
