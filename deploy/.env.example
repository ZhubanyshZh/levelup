# Секреты сервера на VPS. Обычно этот файл не заполняют руками:
# `make server-env IP=1.2.3.4` создаёт deploy/.env со случайными секретами.

# Домен API. Без своего домена подходит <IP через дефисы>.sslip.io — он указывает на этот IP.
DOMAIN=1-2-3-4.sslip.io

POSTGRES_PASSWORD=

JWT_SECRET=

# Client ID iOS-клиента из Google Cloud Console (тот же, что в backend/.env).
GOOGLE_CLIENT_IDS=

# Шифрует ключи ИИ пользователей. Если потерять — ключи придётся ввести заново.
ENCRYPTION_KEY=
